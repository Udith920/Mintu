# ---- Server ----
PORT=3000
NODE_ENV=production
# Public URL of the site (used in email links)
BASE_URL=https://your-domain.com
# Long random string: generate with  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# SQLite database file (put it on a persistent disk/volume when hosting)
DB_FILE=./data/flexura.db

# ---- First admin account (created on first start only) ----
ADMIN_NAME=Clinic Admin
ADMIN_EMAIL=admin@flexuraphysio.in
ADMIN_PASSWORD=ChangeThisPassword!

# ---- Razorpay (online payments in INR: UPI, cards, netbanking) ----
# Get keys at https://dashboard.razorpay.com/app/keys (use rzp_test_... keys for testing)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional: webhook secret for https://your-domain.com/api/payments/razorpay-webhook (events: payment.captured, order.paid)
RAZORPAY_WEBHOOK_SECRET=

# Demo payment screen when Razorpay is not configured. NO REAL MONEY. Set to false in production.
PAYMENT_DEMO=true

# ---- Email (booking confirmations, reminders, cancellations) ----
# Works with Gmail (App Password), Zoho, SendGrid, Amazon SES, Brevo, etc. Leave SMTP_HOST empty to log emails to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Flexura Physio Care <no-reply@flexuraphysio.in>
